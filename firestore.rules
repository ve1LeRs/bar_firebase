rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users: read/update own profile, but NEVER self-elevate role.
    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user');
      allow update: if isSelf(userId)
        && (!('role' in request.resource.data)
            || request.resource.data.role == resource.data.get('role', 'user'));
      allow delete: if false;
    }

    match /cocktails/{id} {
      allow read: if true;
      allow write: if false; // Admin SDK / Mini App admin API only
    }

    match /stoplist/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /ratings/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Website legacy may still create orders; status changes are server-only.
    match /orders/{id} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || resource.data.userId == request.auth.token.phone_number);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    match /bills/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /bonusAccounts/{userId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    match /bonusTransactions/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /promocodes/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /wheelConfig/{id} {
      allow read: if false;
      allow write: if false;
    }

    match /wheelPrizes/{id} {
      allow read: if false;
      allow write: if false;
    }

    match /wheelSpins/{userId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    match /ingredients/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /happyHours/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
